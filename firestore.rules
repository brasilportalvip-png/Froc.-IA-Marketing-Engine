rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }

    // Perfis: usuário autenticado pode ler e criar/atualizar seu próprio documento de usuário
    match /users/{uid} {
      allow read, write: if own(uid);
    }

    // Carteiras: leitura pelo próprio usuário; escrita de saldo protegida
    match /wallets/{uid} {
      allow read: if own(uid);
      allow create: if own(uid);
      allow update, delete: if false;
    }

    // Empresas: proprietário autenticado pode ler e gerenciar
    match /companies/{id} {
      allow read: if resource.data.isPublicInVitrine == true || (signedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Artigos de blog públicos
    match /blogPosts/{id} {
      allow read: if resource.data.status == 'published';
      allow write: if false;
    }

    // Conteúdos, campanhas e agendamentos do usuário
    match /contentItems/{id} {
      allow read, write: if signedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }
    match /campaigns/{id} {
      allow read, write: if signedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }
    match /scheduledPosts/{id} {
      allow read, write: if signedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Transações financeiras, claims de segurança e logs permanecem backend-only
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
