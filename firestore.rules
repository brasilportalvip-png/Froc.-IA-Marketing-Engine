rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }

    // Perfis: leitura restrita ao próprio usuário; criação e atualização exclusivamente via backend /api/auth
    match /users/{uid} {
      allow read: if own(uid);
      allow write: if false;
    }

    // Carteiras: leitura restrita ao próprio usuário; controle de saldo e transações exclusivamente via backend
    match /wallets/{uid} {
      allow read: if own(uid);
      allow write: if false;
    }

    // Empresas: proprietário autenticado pode ler e gerenciar; vitrine pública pode ser lida
    match /companies/{id} {
      allow read: if resource.data.isPublicInVitrine == true || (signedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Artigos de blog públicos
    match /blogPosts/{id} {
      allow read: if resource.data.status == 'published';
      allow write: if false;
    }

    // Conteúdos, campanhas e agendamentos do usuário
    match /contentItems/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /campaigns/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /scheduledPosts/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Transações financeiras, claims de segurança, logs, idempotência e autopilot permanecem backend-only
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
