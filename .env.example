# ==============================================================================
# FROC.IA MARKETING ENGINE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# --- APP & GENERAL ---
NODE_ENV=production
PORT=3000
APP_URL=https://sua-aplicacao.vercel.app
CORS_ORIGINS=https://sua-aplicacao.vercel.app,capacitor://localhost,https://localhost,http://localhost
VITE_API_BASE_URL=
VITE_APP_URL=https://sua-aplicacao.vercel.app

# --- FIREBASE CLIENT (VITE PUBLIC) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- FIREBASE ADMIN SDK (SERVER SECRETS) ---
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- GEMINI AI ---
GEMINI_API_KEY=
GEMINI_MEDIA_API_KEY=
GEMINI_MODEL_TEXT=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-3.1-pro-preview
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite
GEMINI_MODEL_IMAGE=gemini-3.1-flash-image
GEMINI_MODEL_VEO_LITE=veo-3.1-lite-generate-preview
GEMINI_MODEL_VEO_FAST=veo-3.1-generate-preview
GEMINI_MODEL_VEO_CINEMA=veo-3.1-generate-preview

# --- MERCADO PAGO ---
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_BILLING_MODE=subscription

# --- SECURITY & ENCRYPTION ---
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
ADMIN_BOOTSTRAP_KEY=
FREE_SIGNUP_BONUS_CREDITS=25

# --- SUPPORT & BLOG ---
SUPPORT_EMAIL=suporte@suaempresa.com
SUPPORT_WHATSAPP=
AUTO_BLOG_ENABLED=false
BLOG_AUTHOR=Equipe Froc.IA

# --- SOCIAL OAUTH INTEGRATIONS ---
# Meta (Instagram & Facebook)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=

# Google & YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# X (Twitter)
X_CLIENT_ID=
X_CLIENT_SECRET=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Pinterest
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
